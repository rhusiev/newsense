  "query": "\n        SELECT u.id, u.username,\n               COALESCE(s.llm_allowed, true) AS \"llm_allowed!\",\n               COALESCE(s.llm_daily_limit, 70) AS \"llm_daily_limit!\"\n        FROM users u\n        LEFT JOIN user_settings s ON s.user_id = u.id\n        ORDER BY u.username\n        ",
