COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml # Change to whatever files you want to use, separated by colon

WEB_DOMAIN=localhost # in prod smth like example.com
API_DOMAIN=localhost # in prod smth like api.example.com
COOKIE_DOMAIN=.localhost # in prod smth like .example.com
SSL_CERTIFICATE_EMAIL=your.email@example.com

REGISTRATION_ENABLED=true

POSTGRES_DB=newsense_db
POSTGRES_USER=newsense_user
POSTGRES_PASSWORD=pswd_replace_me # Change

TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$NHyK2Ai.aAiVb02r4BTd2uSl/jczkO/YNNGN6aPQ7HHPhA4a6XRXu # pswd_replace_me. Change using `echo $(htpasswd -nB admin) | sed -e s/\\$/\\$\\$/g`

# LLM story summaries. Leave empty to turn the worker off.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 32 bytes, base64; generate with: openssl rand -base64 32
LLM_KEY_ENCRYPTION_KEY=
# Optional JSON provider routing, for example OpenRouter privacy:
# Quote the JSON when sourcing a shell file:
# LLM_PROVIDER_ROUTING='{"data_collection":"deny","zdr":true}'
LLM_PROVIDER_ROUTING=
# Set to 1 once the summary worker has an endpoint; otherwise no card is shown.
LLM_SUMMARIES_ENABLED=0
# GLM 5.3 Flash spends its token budget on reasoning unless effort is low.
# Quote the JSON when sourcing a shell file.
# LLM_REASONING='{"effort":"low"}'
LLM_REASONING=
LLM_SUMMARY_MAX_TOKENS=700
LLM_SUMMARY_INTERVAL_MINUTES=5

# Optional soft-thread settings. THREAD_PAIR_MODEL is a directory with a
# quantized ONNX cross-encoder and tokenizer, mounted into the worker.
# Top-10 cosine candidates are verified by the same LLM endpoint as summaries.
THREAD_LLM_ENABLED=1
THREAD_LLM_THRESHOLD=0.7
THREAD_LLM_MAX_CALLS=2000
THREAD_LLM_DAILY_CALLS=1000
THREAD_LLM_MAX_CHARS=700
THREAD_LLM_CONCURRENCY=8
THREAD_TWO_HOP=0
THREAD_PAIR_MODEL=
THREAD_PAIR_THRESHOLD=0.5
THREAD_PAIR_MAX_LEN=128
THREAD_PAIR_BATCH=64
THREAD_ALTERNATIVE_MIN=0.35
