COMPOSE_FILE=docker-compose.yml:docker-compose.proxy.yml # Change to whatever files you want to use, separated by colon

WEB_DOMAIN=localhost # in prod smth like example.com
API_DOMAIN=localhost # in prod smth like api.example.com
COOKIE_DOMAIN=.localhost # in prod smth like .example.com
SSL_CERTIFICATE_EMAIL=your.email@example.com

REGISTRATION_ENABLED=true

POSTGRES_DB=newsense_db
POSTGRES_USER=newsense_user
POSTGRES_PASSWORD=pswd_replace_me # Change

TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$NHyK2Ai.aAiVb02r4BTd2uSl/jczkO/YNNGN6aPQ7HHPhA4a6XRXu # pswd_replace_me. Change using `echo $(htpasswd -nB admin) | sed -e s/\\$/\\$\\$/g`

# LLM story summaries. Leave empty to turn the worker off.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 32 bytes, base64; generate with: openssl rand -base64 32
LLM_KEY_ENCRYPTION_KEY=
LLM_SUMMARY_INTERVAL_MINUTES=5
